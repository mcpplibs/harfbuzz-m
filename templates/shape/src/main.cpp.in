// {{project.name}} — text shaped by HarfBuzz through import mcpplibs.mwrap.harfbuzz,
// then drawn in the terminal from the shaped glyphs' outlines.
//
//   mcpp run                                      the sample font, "AVA fit flit"
//   mcpp run -- FONT.ttf "TEXT" [FEATURES]        any font and text; FEATURES as
//                                                 hb-shape takes them: -liga,-kern …
//
// Shaping turns text into positioned glyphs: "fi" and "fl" become ligatures
// and "AV" is kerned closer; run it with -liga,-kern to see the difference.
import std;
import mcpplibs.mwrap.harfbuzz;
import sample_font;

using namespace mcpplibs::mwrap::harfbuzz::macros;  // HB_LANGUAGE_INVALID …

namespace {

using Point = std::pair<float, float>;
using Contour = std::vector<Point>;

// Draw functions that flatten each glyph outline into polygons.
struct Outline {
    std::vector<Contour> contours;
    float x = 0, y = 0;  // the glyph's origin on the line
    Point last{};
    void to(float px, float py) {
        last = {px, py};
        contours.back().emplace_back(x + px, y + py);
    }
};

hb_draw_funcs_t* outline_funcs() {
    static hb_draw_funcs_t* funcs = [] {
        hb_draw_funcs_t* f = hb_draw_funcs_create();
        hb_draw_funcs_set_move_to_func(f, [](hb_draw_funcs_t*, void* d, hb_draw_state_t*, float x, float y, void*) {
            auto* o = static_cast<Outline*>(d);
            o->contours.emplace_back();
            o->to(x, y);
        }, nullptr, nullptr);
        hb_draw_funcs_set_line_to_func(f, [](hb_draw_funcs_t*, void* d, hb_draw_state_t*, float x, float y, void*) {
            static_cast<Outline*>(d)->to(x, y);
        }, nullptr, nullptr);
        hb_draw_funcs_set_quadratic_to_func(f, [](hb_draw_funcs_t*, void* d, hb_draw_state_t*, float cx, float cy, float x, float y, void*) {
            auto* o = static_cast<Outline*>(d);
            const auto [x0, y0] = o->last;
            for (int i = 1; i <= 8; ++i) {
                const float t = i / 8.f, u = 1 - t;
                o->to(u * u * x0 + 2 * u * t * cx + t * t * x, u * u * y0 + 2 * u * t * cy + t * t * y);
            }
        }, nullptr, nullptr);
        hb_draw_funcs_set_cubic_to_func(f, [](hb_draw_funcs_t*, void* d, hb_draw_state_t*, float c1x, float c1y, float c2x, float c2y,
                                              float x, float y, void*) {
            auto* o = static_cast<Outline*>(d);
            const auto [x0, y0] = o->last;
            for (int i = 1; i <= 12; ++i) {
                const float t = i / 12.f, u = 1 - t;
                o->to(u * u * u * x0 + 3 * u * u * t * c1x + 3 * u * t * t * c2x + t * t * t * x,
                      u * u * u * y0 + 3 * u * u * t * c1y + 3 * u * t * t * c2y + t * t * t * y);
            }
        }, nullptr, nullptr);
        hb_draw_funcs_make_immutable(f);
        return f;
    }();
    return funcs;
}

// Non-zero winding: is (px, py) inside the outline?
bool inside(const std::vector<Contour>& contours, float px, float py) {
    int winding = 0;
    for (const Contour& c : contours)
        for (std::size_t i = 0; i < c.size(); ++i) {
            const auto [x0, y0] = c[i];
            const auto [x1, y1] = c[(i + 1) % c.size()];
            const float side = (x1 - x0) * (py - y0) - (px - x0) * (y1 - y0);
            if (y0 <= py && y1 > py && side > 0) ++winding;
            else if (y0 > py && y1 <= py && side < 0) --winding;
        }
    return winding != 0;
}

std::string serialize(hb_buffer_t* buffer, hb_font_t* font) {
    std::string out;
    const unsigned n = hb_buffer_get_length(buffer);
    for (unsigned start = 0; start < n;) {
        char chunk[4096];
        unsigned consumed = 0;
        start += hb_buffer_serialize(buffer, start, n, chunk, sizeof chunk, &consumed, font, HB_BUFFER_SERIALIZE_FORMAT_TEXT,
                                     HB_BUFFER_SERIALIZE_FLAG_DEFAULT);
        if (!consumed) break;
        out += chunk;
    }
    return out;
}

}  // namespace

int main(int argc, char** argv) {
    hb_blob_t* blob = argc > 1 ? hb_blob_create_from_file_or_fail(argv[1])
                               : hb_blob_create(reinterpret_cast<const char*>(sample_font.data()),
                                                static_cast<unsigned>(sample_font.size()), HB_MEMORY_MODE_READONLY, nullptr, nullptr);
    if (!blob) {
        std::println(std::cerr, "cannot read the font {}", argv[1]);
        return 1;
    }
    const std::string text = argc > 2 ? argv[2] : "AVA fit flit";
    std::vector<hb_feature_t> features;
    if (argc > 3)
        for (auto part : std::views::split(std::string_view(argv[3]), ',')) {
            hb_feature_t feature;
            const std::string_view spec(part);
            if (hb_feature_from_string(spec.data(), static_cast<int>(spec.size()), &feature)) features.push_back(feature);
        }

    hb_face_t* face = hb_face_create(blob, 0);
    hb_font_t* font = hb_font_create(face);  // scaled in font units
    hb_buffer_t* buffer = hb_buffer_create();
    hb_buffer_add_utf8(buffer, text.data(), static_cast<int>(text.size()), 0, static_cast<int>(text.size()));
    hb_buffer_guess_segment_properties(buffer);  // direction, script and language from the text
    hb_shape(font, buffer, features.data(), static_cast<unsigned>(features.size()));

    char family[128];
    unsigned family_length = sizeof family;
    hb_ot_name_get_utf8(face, HB_OT_NAME_ID_FONT_FAMILY, HB_LANGUAGE_INVALID, &family_length, family);
    std::println("{} glyphs of \"{}\" in {} (HarfBuzz {}):", hb_buffer_get_length(buffer), text, family, hb_version_string());
    std::println("{}", serialize(buffer, font));

    // Every glyph's outline at its shaped position, then the line in cells.
    unsigned count = 0;
    const hb_glyph_info_t* info = hb_buffer_get_glyph_infos(buffer, &count);
    const hb_glyph_position_t* pos = hb_buffer_get_glyph_positions(buffer, &count);
    Outline outline;
    float pen = 0;
    for (unsigned i = 0; i < count; ++i) {
        outline.x = pen + static_cast<float>(pos[i].x_offset);
        outline.y = static_cast<float>(pos[i].y_offset);
        hb_font_draw_glyph(font, info[i].codepoint, outline_funcs(), &outline);
        pen += static_cast<float>(pos[i].x_advance);
    }
    hb_font_extents_t extents;
    hb_font_get_h_extents(font, &extents);
    constexpr int rows = 12;
    const float cell_height = static_cast<float>(extents.ascender - extents.descender) / rows;
    const float cell_width = cell_height / 2;  // terminal cells are about twice as tall as wide
    const int columns = static_cast<int>(std::ceil(pen / cell_width));
    for (int row = 0; row < rows; ++row) {
        std::string line;
        const float y = static_cast<float>(extents.ascender) - (row + 0.5f) * cell_height;
        for (int column = 0; column < columns; ++column) line += inside(outline.contours, (column + 0.5f) * cell_width, y) ? '#' : ' ';
        while (!line.empty() && line.back() == ' ') line.pop_back();
        std::println("{}", line);
    }

    hb_buffer_destroy(buffer);
    hb_font_destroy(font);
    hb_face_destroy(face);
    hb_blob_destroy(blob);
}
